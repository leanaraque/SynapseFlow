dist/
build/

# Entorno y secretos
#
# `.env.*` y no solo `.env.local`: el patrón anterior dejaba afuera
# `.env.production`, `.env.development` y cualquier variante que Vite reconoce.
# El archivo de la consola no tiene secretos —la config de Firebase viaja en el
# bundle— pero un patrón que cubre unas variantes y no otras enseña a confiar en
# que el .gitignore te cubre, y ahí es donde entra la que sí tenía una clave.
.env
.env.*
!.env.example
*-service-account.json
service-account*.json

# Node / web
node_modules/
apps/web/dist/
.vite/

# Firebase
.firebase/
*-debug.log
firebase-debug.*.log
.runtimeconfig.json

# Instrucciones locales de asistentes de código: no forman parte del proyecto.
CLAUDE.md
.claude/
.cursorrules
.aider*

# Datos generados y artefactos de evaluación
#
# `data/generado/` lo produce scripts/generar_datos.py y se reconstruye con la
# semilla, así que versionarlo sería guardar algo derivado. `data/corpus/` NO va
# acá: el corpus de normativa es fuente, se escribe a mano y se versiona.
data/generado/
evals/results/
*.local.json

# Sistema operativo / editores
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/settings.json

