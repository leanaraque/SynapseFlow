# Normaliza los finales de línea a LF en el repositorio.
#
# Sin esto, un clon en Windows commitea CRLF y cada diff entre colaboradores de
# distinta plataforma aparece como "el archivo entero cambió".
* text=auto eol=lf

# Scripts que solo corren en Windows y necesitan CRLF.
*.ps1  text eol=crlf
*.bat  text eol=crlf
*.cmd  text eol=crlf

# Binarios: nunca tocar.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.pdf   binary
*.woff  binary
*.woff2 binary
*.zip   binary

# Excluidos del tarball que GitHub genera para cada release.
.github/        export-ignore
tests/          export-ignore
.gitattributes  export-ignore
.gitignore      export-ignore
.editorconfig   export-ignore
