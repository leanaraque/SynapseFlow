# ─────────────────────────────────────────────────────────────────────────────
# SynapseFlow — configuración de entorno
# Copiar a .env y completar. Nunca comitear .env.
# ─────────────────────────────────────────────────────────────────────────────

# ── Proveedor de LLM activo ──────────────────────────────────────────────────
# Uno de: gemini | openai | azure_openai | anthropic | fake
#
# `fake` devuelve un modelo determinístico que no sale a la red ni consume cuota.
# Es lo que usan los tests, y sirve para levantar la plataforma entera sin
# credenciales de ningún proveedor.
SYNAPSEFLOW_PROVIDER=gemini

# Proveedor al que degradar si el activo falla. Vacío = sin respaldo.
#
# El default es vacío a propósito: un respaldo silencioso manda el texto a un
# proveedor que nadie eligió, y en un cliente regulado *qué proveedor recibe qué
# dato* es una decisión con dueño. Si el proveedor nombrado acá no tiene
# credenciales, el gateway lo descarta en lugar de encadenar algo que falla igual.
SYNAPSEFLOW_FALLBACK_PROVIDER=

# Gemini (default del demo)
GOOGLE_API_KEY=

# OpenAI (adapter alternativo)
OPENAI_API_KEY=

# Azure OpenAI (adapter alternativo)
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_CHAT_DEPLOYMENT=
AZURE_OPENAI_EMBEDDINGS_DEPLOYMENT=

# Anthropic (adapter alternativo)
ANTHROPIC_API_KEY=

# ── Firebase / GCP ───────────────────────────────────────────────────────────
GOOGLE_CLOUD_PROJECT=synapseflow-5fc52
FIRESTORE_DATABASE=(default)
# Solo para desarrollo local: ruta a la service account.
# En Cloud Run se usa la identidad del servicio (ADC), sin archivo de clave.
GOOGLE_APPLICATION_CREDENTIALS=

# Emulador de Firestore para desarrollo local (opcional)
# FIRESTORE_EMULATOR_HOST=localhost:8080

# ── LangSmith (observabilidad y evals) ───────────────────────────────────────
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=synapseflow-dev
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# ── Política de gobernanza ───────────────────────────────────────────────────
# Rechaza proveedores que no garanticen no-entrenamiento con datos del cliente.
SYNAPSEFLOW_ENFORCE_ZERO_TRAINING=true
# Redacta PII antes de que el texto salga hacia el proveedor de LLM.
SYNAPSEFLOW_REDACT_PII=true
# Toda acción marcada como irreversible en la ontología requiere aprobación humana.
SYNAPSEFLOW_REQUIRE_APPROVAL=true
