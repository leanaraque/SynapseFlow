# Configuración de Firebase para la consola.
#
# Estos valores NO son secretos: identifican al proyecto y viajan en cualquier
# bundle del navegador. Lo que protege los datos son las reglas de Firestore
# —que cierran el acceso directo del cliente— y el RBAC que aplica la API.
#
# Van por variables de entorno igual, para que el mismo código sirva a los
# proyectos de desarrollo y de producción sin recompilar decisiones.
#
# Se copian de la consola de Firebase: Configuración del proyecto → Tus apps.
#
#     cp .env.example .env.local

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=synapseflow-5fc52.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=synapseflow-5fc52
VITE_FIREBASE_APP_ID=

# URL de la API. Vacía en desarrollo: las rutas quedan relativas y las reenvía el
# proxy de Vite.
#
# En producción hace falta, y no es una preferencia: el rewrite de Firebase
# Hosting corta a los 60 segundos y un recorrido completo tarda ~52 s. Sin esto,
# la consulta que se pase un poco devuelve 502.
VITE_API_BASE=
